# Copy to .env (docker compose picks it up automatically) and fill in.

# --- game server ---------------------------------------------------------
NMRIH_HOSTNAME=NMRiH Server
NMRIH_MAP=nmo_broadway
NMRIH_MAXPLAYERS=8
NMRIH_PORT=27015
NMRIH_CLIENT_PORT=27005
NMRIH_TV_PORT=27020
NMRIH_TV_ENABLE=0
# Master-server region: 0 US-east, 3 Europe, 7 world.
NMRIH_SV_REGION=3
NMRIH_SV_CONTACT=
# Empty = public server / rcon disabled.
NMRIH_SV_PASSWORD=
NMRIH_RCON_PASSWORD=
# Game Server Login Token for app id 317670, from
# https://steamcommunity.com/dev/managegameservers - without it the server
# still accepts direct connects but is not listed in the public browser.
NMRIH_GSLT=
# Host directory for the Steam install (~9 GB).
NMRIH_DATA_DIR=./server_data
# Extra srcds arguments, e.g. "+sv_gravity 600 -tickrate 66".
NMRIH_EXTRA_ARGS=
# 1 = install Metamod:Source + SourceMod and the plugins from sourcemod/plugins
# on start (default), 0 = leave the server vanilla. The versions themselves are
# pinned as build args in nmrih_server/Dockerfile.
NMRIH_SOURCEMOD=1
# 1 = skip the steamcmd update on container start (fastest restarts).
NMRIH_SKIP_UPDATE=0
# 1 = re-validate every game file on each start (slow; `make server-update`
# does this on demand, so leave it off).
NMRIH_VALIDATE=

# --- dashboard -----------------------------------------------------------
# A2S target for the live player list; the compose default is the game
# container next door, override to monitor a server elsewhere.
SERVER_ADDR=nmrih_server
LOGS_FILE_PATTERN=[Ll]*.log
# https://ipinfo.io token, used to resolve player IPs to countries.
IP_INFO_API_TOKEN=
REDIS_PASSWORD=
TRAEFIK_ACME_EMAIL=
TRAEFIK_ACME_STORAGE=/etc/traefik/acme/acme.json
# Set to another Traefik's docker network (e.g. dealscout_default) when that
# proxy already owns :80/:443 on this host: the bundled traefik is then left
# out and the dashboard containers join that network instead.
PROXY_NETWORK=
# Only needed when this stack runs its own DuckDNS updater
# (`docker compose --profile public up -d duckdns`).
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
